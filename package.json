{
  "name": "douyin-following-review",
  "productName": "抖音整理箱",
  "version": "2.3.0",
  "private": true,
  "description": "本地抖音关注管理、互动记录整理与粉丝团查询工具箱",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/assets.cjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "smoke": "node scripts/smoke.cjs",
    "smoke:groups": "node scripts/group-smoke.cjs",
    "package": "npm run build && node scripts/package.cjs",
    "smoke:fanclub": "node scripts/fanclub-smoke.cjs",
    "smoke:tools": "node scripts/toolbox-smoke.cjs",
    "smoke:chat": "node scripts/chat-smoke.cjs",
    "smoke:checkin": "node scripts/checkin-smoke.cjs",
    "smoke:organization": "node scripts/organization-smoke.cjs"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "electron": "44.5.1",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "exceljs": "4.4.0"
  }
}
